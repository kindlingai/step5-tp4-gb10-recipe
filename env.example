# Documentation placeholders; replace with your own isolated cluster addresses.
NODE0=192.168.50.11
NODE1=192.168.50.12
NODE2=192.168.50.13
NODE3=192.168.50.14
NETWORK_IFACE=eth0
# Example HCA names only: replace with the two active fabric rails on each node.
RDMA_HCA=mlx5_0,mlx5_1
NCCL_CROSS_NIC=1
NCCL_MIN_NCHANNELS=2
NCCL_MAX_NCHANNELS=2
NFS_CLIENT_CIDR=192.168.50.0/24
SSH_USER=
STEP5_ROOT=/srv/step5
CACHE_DIR=/var/cache/step5
SOURCE_DIR=/mnt/model-source
IMAGE=vllm/vllm-openai:step-5-preview
MODEL_REVISION=bc246cc2848e17b37f377eda8fd825c5b3018d1f
MAXLEN=196608
MAXSEQ=8
GMU=0.85
BATCH_TOKENS=4096
KV_DTYPE=auto
STEP5_DENSE=1
LMONLY=1
SPEC_TOKENS=3
DROP_PAGE_CACHE=1
API_PORT=18000
MASTER_PORT=29511
CONTAINER_PREFIX=step5

# The benchmark reads these exported variables.
BENCH_HOSTS="$NODE0,$NODE1,$NODE2,$NODE3"
CLIENT_LABEL=client
